{
  "name": "@agent-recall/mcp",
  "version": "0.4.0",
  "description": "stdio MCP entry for agent-recall. Forwards server tools and runs local file tools on the user's computer.",
  "private": false,
  "type": "module",
  "bin": {
    "agent-recall-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximing/agent-recall.git",
    "directory": "apps/mcp"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
