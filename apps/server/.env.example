# Copy to .env.test or .env.production. Those files stay out of git.
# pnpm dev loads .env.test and connects directly, without the local HTTP proxy.
# APP_ENV=production loads .env.production. APP_ENV wins over NODE_ENV.

APP_ENV=test
PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8787
WEB_ORIGIN=http://127.0.0.1:5178
COOKIE_SECURE=false

# Dedicated database. Do not use the postgres superuser.
DATABASE_URL=postgresql://agent_recall_test_user:password@192.168.9.109:5432/agent_recall_test

# Meilisearch. Use the index-scoped key, not the master key.
# LAN: http://192.168.9.109:7700
# WAN: http://222.128.65.91:7700
MEILI_URL=http://192.168.9.109:7700
MEILI_API_KEY=
MEILI_INDEX=agent-recall-memories-test

# Qdrant on the same host. Leave blank until the API key is set.
QDRANT_URL=http://192.168.9.109:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agent-recall-memories-test

# DashScope multimodal embeddings. Required for the vector path.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_MODEL=qwen3-vl-embedding
EMBEDDING_DIMENSIONS=2560

# Optional. The app does not open Redis yet. Sessions live in Postgres.
# LAN redis is 192.168.9.102:16379. WAN port is 16379.
REDIS_URL=
